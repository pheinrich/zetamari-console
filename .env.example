# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=http://localhost:3000${BASEPATH}
NEXT_PUBLIC_DOCS_URL=https://demos.themeselection.com/marketplace/materio-mui-nextjs-admin-template/documentation

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
NEXTAUTH_BASEPATH=${BASEPATH}/api/auth
NEXTAUTH_URL=http://localhost:3000${BASEPATH}/api/auth
NEXTAUTH_SECRET=

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_URL=http://localhost:3000${BASEPATH}/api
NEXT_PUBLIC_API_URL=${API_URL}

# -----------------------------------------------------------------------------
# Inbound order email (/api/inbound/order-email)
# -----------------------------------------------------------------------------
# Shared secret the inbound-email service must present, as a Bearer token or
# as the Basic auth password. Generate with: openssl rand -hex 32
INBOUND_EMAIL_SECRET=
# Amazon SES inbound mail via SNS (see src/libs/channelOrders/sns.js):
# only this topic's messages are accepted, and raw emails are fetched
# only from this bucket, as the IAM user below (s3:GetObject only).
# Not the standard AWS_* names - Vercel reserves those.
INBOUND_EMAIL_SNS_TOPIC_ARN=
INBOUND_EMAIL_S3_BUCKET=zetamari-inbound-email
INBOUND_EMAIL_AWS_REGION=us-west-2
INBOUND_EMAIL_AWS_ACCESS_KEY_ID=
INBOUND_EMAIL_AWS_SECRET_ACCESS_KEY=
# Faire brand API key (Brand Portal -> Settings -> Integrations), used to
# fetch the full line list Faire's order emails cut off.
FAIRE_API_KEY=
# Etsy app keystring and shared secret (developer.etsy.com -> Your Apps).
# The shop's own OAuth tokens are stored in the ApiCredentials table by
# "Connect Etsy" on the Channel Orders page; register
# https://console.zetamari.com/api/etsy/callback (and
# http://localhost:3000/api/etsy/callback for development) as the app's
# callback URLs.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Mapbox
# -----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
